.DS_Store
node_modules/

# An Obsidian vault (personal notes) can end up here because macOS's default
# filesystem is case-insensitive: ~/Documents/Strobrie and this repo's own
# ~/Documents/strobrie are literally the same directory on disk.
.obsidian/

# Source menu photos you drop in for me to crop/extract artwork from —
# not app assets themselves, so not tracked in git.
menu-images/

# The Obsidian vault folder itself, for the same case-insensitive reason as
# .obsidian above — it is personal notes, not part of the app.
/Strobrie/
