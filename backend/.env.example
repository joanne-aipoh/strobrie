DATABASE_URL=postgresql+psycopg://strobrie:strobrie@localhost/strobrie
CORS_ORIGINS=http://localhost:5173

# Frontend origin used to build Paystack's callback_url (where customers land
# after paying). In production this should be https://shop.strobrie.com.
FRONTEND_URL=http://localhost:5173

# From your Paystack dashboard (Settings > API Keys & Webhooks). Never commit
# a real key — this file is just the template, copy it to .env and fill in.
PAYSTACK_SECRET_KEY=
