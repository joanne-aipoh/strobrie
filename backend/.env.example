DATABASE_URL=postgresql+psycopg://strobrie:strobrie@localhost/strobrie
CORS_ORIGINS=http://localhost:5173

# Frontend origin used to build Paystack's callback_url (where customers land
# after paying). In production this should be https://shop.strobrie.com.
FRONTEND_URL=http://localhost:5173

# From your Paystack dashboard (Settings > API Keys & Webhooks). Never commit
# a real key — this file is just the template, copy it to .env and fill in.
PAYSTACK_SECRET_KEY=

# Sends order-confirmation emails via the shop's own Gmail account — no
# separate email service needed. SMTP_USER is the Gmail address itself.
# SMTP_PASSWORD is a 16-character Gmail "App Password" (NOT the normal Gmail
# login password) — generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be turned on for that Gmail account first).
# If either is left blank, order emails are silently skipped — checkout still
# works fine, customers just won't get an emailed confirmation.
SMTP_USER=
SMTP_PASSWORD=
